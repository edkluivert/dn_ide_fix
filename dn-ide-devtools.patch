+  /// Makes an IDE project (`.idea/`) beside the pubspec name this SDK's Dart
+  /// SDK, so the JetBrains Dart plugin starts the Dart Tooling Daemon and
+  /// DevTools when the project opens.
+  ///
+  /// The Dart plugin launches DTD and DevTools once, in its project startup
+  /// activity, and only when a module already carries the "Dart SDK" library
+  /// (`DartStartupActivity` → `DartToolingDaemonService.startService`; nothing
+  /// starts them later, a later SDK change only re-roots the analysis server).
+  /// A project opened before its SDK was configured — the `plugin`,
+  /// `plugin_ffi` and `package_ffi` templates shipped without `.idea/`, and any
+  /// folder first opened from the IDE — has no DevTools for the whole session:
+  /// the Flutter plugin only waits for the Dart plugin's instance and reports
+  /// "Timed out waiting for Dart plugin to start DevTools". Two files put that
+  /// right for the next open: `.idea/libraries/Dart_SDK.xml` and a "Dart SDK"
+  /// order entry in the module file. Each is written only when missing; one
+  /// that exists is the author's (or the IDE's) and is left alone.
+  void _registerIdeDartSdk(FlutterProject project) {
+    final Directory idea = project.directory.childDirectory('.idea');
+    if (!idea.existsSync()) {
+      return;
+    }
+    final String? root = Cache.flutterRoot;
+    if (root == null) {
+      return;
+    }
+    final String dartSdk = _fileSystem.path.join(root, 'bin', 'cache', 'dart-sdk');
+    final changed = <String>[];
+
+    final File library = idea.childDirectory('libraries').childFile('Dart_SDK.xml');
+    if (!library.existsSync()) {
+      library.parent.createSync(recursive: true);
+      library.writeAsStringSync(_ideDartSdkLibraryXml(dartSdk));
+      changed.add('.idea/libraries/Dart_SDK.xml');
+    }
+    const String entry = '    <orderEntry type="library" name="Dart SDK" level="project" />\n';
+    for (final File module in _ideModuleFiles(project, idea)) {
+      final String text = module.readAsStringSync();
+      if (text.contains('name="Dart SDK"')) {
+        continue;
+      }
+      final int close = text.lastIndexOf('  </component>');
+      if (close < 0) {
+        continue;
+      }
+      module.writeAsStringSync(text.substring(0, close) + entry + text.substring(close));
+      changed.add(_fileSystem.path.relative(module.path, from: project.directory.path));
+    }
+    if (changed.isEmpty) {
+      return;
+    }
+    _logger.printStatus(
+      'dartnative: registered this Dart SDK with the IDE project '
+      '(${changed.join(', ')}). Reopen the project in Android Studio / IntelliJ '
+      'once so its Dart plugin starts DevTools.',
+    );
+  }
+
+  /// The Dart module files of an IDE project: those `.idea/modules.xml` lists,
+  /// else any `.iml` in `.idea/` or beside the pubspec. Only modules at those
+  /// two places count: a module elsewhere (`android/*.iml`, the Android side
+  /// of an app) is not a Dart module and gets no Dart SDK.
+  List<File> _ideModuleFiles(FlutterProject project, Directory idea) {
+    final files = <File>[];
+    bool isDartModule(File file) {
+      final String dir = _fileSystem.path.canonicalize(file.parent.path);
+      return dir == _fileSystem.path.canonicalize(project.directory.path) ||
+          dir == _fileSystem.path.canonicalize(idea.path);
+    }
+    final File modules = idea.childFile('modules.xml');
+    if (modules.existsSync()) {
+      for (final RegExpMatch match
+          in RegExp(r'filepath="([^"]+\.iml)"').allMatches(modules.readAsStringSync())) {
+        final String path = match.group(1)!.replaceAll(r'$PROJECT_DIR$', project.directory.path);
+        final File file = _fileSystem.file(path);
+        if (file.existsSync() && isDartModule(file)) {
+          files.add(file);
+        }
+      }
+    }
+    if (files.isEmpty) {
+      for (final Directory dir in <Directory>[idea, project.directory]) {
+        files.addAll(
+          dir.listSync().whereType<File>().where((File f) => f.path.endsWith('.iml')),
+        );
+      }
+    }
+    return files;
+  }
+
+  /// `.idea/libraries/Dart_SDK.xml` for the Dart SDK at [dartSdk], the file the
+  /// `app` and `package` templates write.
+  String _ideDartSdkLibraryXml(String dartSdk) {
+    const libs = <String>[
+      'async', 'collection', 'convert', 'core', 'developer', 'html', 'io',
+      'isolate', 'math', 'mirrors', 'typed_data',
+    ];
+    final buffer = StringBuffer()
+      ..writeln('<component name="libraryTable">')
+      ..writeln('  <library name="Dart SDK">')
+      ..writeln('    <CLASSES>');
+    for (final String lib in libs) {
+      buffer.writeln('      <root url="file://$dartSdk/lib/$lib" />');
+    }
+    buffer
+      ..writeln('    </CLASSES>')
+      ..writeln('    <JAVADOC />')
+      ..writeln('    <SOURCES />')
+      ..writeln('  </library>')
+      ..write('</component>');
+    return buffer.toString();
+  }
